<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- ============ 第一段：点右侧当前值弹出选项列表 ============ -->
        <!-- 取值块统一 120dp 宽、右边缘贴齐，所以每行的值、下划线、小三角都落同一条竖线上；整行可点 -->
        <!-- 书名显示方式（显示 / 隐藏 / 叠加） -->
        <LinearLayout
            android:id="@+id/book_name_choice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="8dp"
                android:text="@string/book_name"
                android:textColor="@color/primaryText"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_book_name"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_value_line"
                android:drawableEnd="@drawable/ic_value_arrow"
                android:drawablePadding="2dp"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:paddingEnd="5dp"
                android:paddingVertical="8dp"
                android:textColor="@color/primaryText"
                android:textSize="14sp"
                tools:ignore="RtlSymmetry" />
        </LinearLayout>



        <!-- 排序（按书名 / 按作者 / 手动排序 / 综合排序 / 按阅读时间 / 按更新时间） -->
        <LinearLayout
            android:id="@+id/ll_sort_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@+id/book_name_choice">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="8dp"
                android:text="@string/sort"
                android:textColor="@color/primaryText"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_sort"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_value_line"
                android:drawableEnd="@drawable/ic_value_arrow"
                android:drawablePadding="2dp"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:paddingEnd="5dp"
                android:paddingVertical="8dp"
                android:textColor="@color/primaryText"
                android:textSize="14sp"
                tools:ignore="RtlSymmetry" />
        </LinearLayout>



        <!-- 书籍视图（列表 / 网格二~六列 / 紧凑列表） -->
        <LinearLayout
            android:id="@+id/ll_book_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@+id/ll_sort_row">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="8dp"
                android:text="@string/book_view"
                android:textColor="@color/primaryText"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_book_view"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_value_line"
                android:drawableEnd="@drawable/ic_value_arrow"
                android:drawablePadding="2dp"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:paddingEnd="5dp"
                android:paddingVertical="8dp"
                android:textColor="@color/primaryText"
                android:textSize="14sp"
                tools:ignore="RtlSymmetry" />
        </LinearLayout>



        <!-- 立体封面（无 / 光影 / 折痕 / 书脊） -->
        <LinearLayout
            android:id="@+id/book_cover_style_choice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@+id/ll_book_view">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="8dp"
                android:text="@string/book_cover_style"
                android:textColor="@color/primaryText"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_cover_style"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_value_line"
                android:drawableEnd="@drawable/ic_value_arrow"
                android:drawablePadding="2dp"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:paddingEnd="5dp"
                android:paddingVertical="8dp"
                android:textColor="@color/primaryText"
                android:textSize="14sp"
                tools:ignore="RtlSymmetry" />
        </LinearLayout>



        <!-- 分组样式（标签 / 文件夹），放第一段最下面 -->
        <LinearLayout
            android:id="@+id/ll_group_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@+id/book_cover_style_choice">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="8dp"
                android:text="@string/group_style"
                android:textColor="@color/primaryText"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_group_style"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_value_line"
                android:drawableEnd="@drawable/ic_value_arrow"
                android:drawablePadding="2dp"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:paddingEnd="5dp"
                android:paddingVertical="8dp"
                android:textColor="@color/primaryText"
                android:textSize="14sp"
                tools:ignore="RtlSymmetry" />
        </LinearLayout>



        <!-- 文件夹视图（仅在分组样式为文件夹时出现，紧跟其下） -->
        <LinearLayout
            android:id="@+id/ll_folder_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/ll_group_style">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="8dp"
                android:text="@string/folder_view"
                android:textColor="@color/primaryText"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_folder_view"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_value_line"
                android:drawableEnd="@drawable/ic_value_arrow"
                android:drawablePadding="2dp"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:paddingEnd="5dp"
                android:paddingVertical="8dp"
                android:textColor="@color/primaryText"
                android:textSize="14sp"
                tools:ignore="RtlSymmetry" />
        </LinearLayout>



        <!-- ============ 第二段：开关 ============ -->
        <!-- 下拉选择分组（仅分组样式为标签时显示） -->
        <io.legado.app.lib.theme.view.ThemeSwitch
            android:id="@+id/sw_dropdown_select_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingVertical="8dp"
            android:text="@string/dropdown_select_group"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/ll_folder_view"
            tools:ignore="TouchTargetSizeCheck" />



        <!-- 书籍外边框（仅列表/紧凑列表时显示） -->
        <io.legado.app.lib.theme.view.ThemeSwitch
            android:id="@+id/sw_show_book_border"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="@string/show_book_border"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_goneMarginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/sw_dropdown_select_group"
            tools:ignore="TouchTargetSizeCheck" />



        <!-- 显示书架标签 -->
        <io.legado.app.lib.theme.view.ThemeSwitch
            android:id="@+id/sw_show_bookshelf_tag_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="@string/show_bookshelf_tag_bar"
            android:textSize="14sp"
            app:layout_goneMarginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/sw_show_book_border"
            tools:ignore="TouchTargetSizeCheck" />



        <!-- 显示更多信息（仅在列表视图时显示） -->
        <LinearLayout
            android:id="@+id/ll_show_more_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/sw_show_bookshelf_tag_bar">

            <io.legado.app.lib.theme.view.ThemeSwitch
                android:id="@+id/sw_show_more_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="@string/show_more_info"
                android:textSize="14sp"
                tools:ignore="TouchTargetSizeCheck" />

            <io.legado.app.lib.theme.view.ThemeSwitch
                android:id="@+id/sw_show_read_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:paddingVertical="8dp"
                android:text="@string/show_bookshelf_read_progress"
                android:textSize="14sp"
                android:visibility="gone"
                tools:ignore="TouchTargetSizeCheck" />

            <io.legado.app.lib.theme.view.ThemeSwitch
                android:id="@+id/sw_show_category_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:paddingVertical="8dp"
                android:text="@string/show_category_info"
                android:textSize="14sp"
                android:visibility="gone"
                tools:ignore="TouchTargetSizeCheck" />

            <io.legado.app.lib.theme.view.ThemeSwitch
                android:id="@+id/sw_show_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:paddingVertical="8dp"
                android:text="@string/show_intro"
                android:textSize="14sp"
                android:visibility="gone"
                tools:ignore="TouchTargetSizeCheck" />

            <!-- 简介行数：与上面三行同款「标题 + 右侧当前值」 -->
            <LinearLayout
                android:id="@+id/ll_intro_lines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingVertical="8dp"
                    android:text="@string/intro_lines"
                    android:textColor="@color/primaryText"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_intro_lines"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_value_line"
                    android:drawableEnd="@drawable/ic_value_arrow"
                    android:drawablePadding="2dp"
                    android:ellipsize="end"
                    android:gravity="end|center_vertical"
                    android:maxLines="1"
                    android:paddingEnd="5dp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/primaryText"
                    android:textSize="14sp"
                    tools:ignore="RtlSymmetry" />
            </LinearLayout>

        </LinearLayout>



        <!-- 显示未读标志 -->
        <io.legado.app.lib.theme.view.ThemeSwitch
            android:id="@+id/sw_show_unread"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="@string/show_unread"
            android:textSize="14sp"
            app:layout_goneMarginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/ll_show_more_info"
            tools:ignore="TouchTargetSizeCheck" />



        <!-- 显示快速滚动条 -->
        <io.legado.app.lib.theme.view.ThemeSwitch
            android:id="@+id/sw_show_bookshelf_fast_scroller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="@string/show_bookshelf_fast_scroller"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@+id/sw_show_unread"
            tools:ignore="TouchTargetSizeCheck" />



        <!-- 显示上次更新时间 -->
        <io.legado.app.lib.theme.view.ThemeSwitch
            android:id="@+id/sw_show_last_update_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="@string/show_last_update_time"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@+id/sw_show_bookshelf_fast_scroller"
            tools:ignore="TouchTargetSizeCheck" />



        <!-- 显示等待更新数量 -->
        <io.legado.app.lib.theme.view.ThemeSwitch
            android:id="@+id/sw_show_wait_up_books"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="@string/show_wait_up_count"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@+id/sw_show_last_update_time"
            tools:ignore="TouchTargetSizeCheck" />



        <!-- 间距设置（下方留出空位，不贴着弹窗底边，方便拖动） -->
        <io.legado.app.ui.widget.DetailSeekBar
            android:id="@+id/margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sw_show_wait_up_books"
            app:max="60"
            app:title="@string/margin" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>